{
  "name": "@retiregolden/mcp",
  "version": "0.9.1",
  "description": "Model Context Protocol server for the RetireGolden retirement-planning engine: headless, in-memory sessions over stdio (and optional HTTP).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetireGolden/RetireGolden-MCP.git"
  },
  "homepage": "https://github.com/RetireGolden/RetireGolden-MCP#readme",
  "bugs": "https://github.com/RetireGolden/RetireGolden-MCP/issues",
  "keywords": [
    "mcp",
    "retirement",
    "financial-planning",
    "retiregolden",
    "model-context-protocol"
  ],
  "bin": {
    "retiregolden-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "docs",
    "LICENSE",
    "DISCLAIMER.md",
    "README.md",
    "TRADEMARKS.md",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "baseline:capture": "node scripts/capture-protocol-baseline.mjs",
    "contract:generate": "node scripts/gen-tool-contract.mjs",
    "goldens:print": "node scripts/gen-goldens.mjs",
    "mcp": "node dist/cli.js",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.parity.json && vitest run",
    "test:packed": "vitest run tests/packedArtifact.test.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@retiregolden/engine": "0.3.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.6"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@retiregolden/planner-ui": "0.10.0",
    "@types/node": "^26.1.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
